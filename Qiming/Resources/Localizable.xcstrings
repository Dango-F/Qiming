    "thermal.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Warns when your Mac gets warm. Serious or critical thermal states end the session, request screen sleep and release keep-awake. This protection is always enabled."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备升温时提醒；系统热状态达到过热或严重过热时，结束会话、请求熄屏并清理保活。此保护始终启用。"
          }
        }
      }
    },

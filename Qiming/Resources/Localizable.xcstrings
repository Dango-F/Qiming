    "helper.changes": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The helper performs fixed power operations and temporarily disables system sleep. Always On also pauses this user’s screen saver. Original values are journaled and restored. Brightness and idle display timers are unchanged. Passwords are never saved."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "组件只执行限定电源操作，临时禁止系统睡眠；始终常亮期间暂停本用户屏保。修改前记录原值，结束时恢复。不会修改亮度、闲置熄屏时长或保存密码。"
          }
        }
      }
    },

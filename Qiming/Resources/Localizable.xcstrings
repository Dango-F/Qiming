        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This local build needs an Apple-issued signing identity. Select the same Team for Qiming and QimingHelper in Xcode, then rebuild. The privileged helper rejects unsigned clients."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此本地构建尚未使用 Apple 开发者证书签名。请在 Xcode 中为主程序和 QimingHelper 选择相同 Team 后重新构建。辅助组件不会接受未签名客户端。"
          }
        }
      }
    },

    "risk.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep the screen on while closed?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "合盖后也保持屏幕常亮？"
          }
        }
      }
    },
    "risk.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The built-in screen stays on with the lid closed. Automatic locking, screen saver and display sleep are paused. Long sessions with static content or high brightness increase image-retention, display wear and heat risks. Keep your Mac ventilated."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "内屏在合盖后仍持续点亮，自动锁屏、屏保与显示睡眠将暂停。长时间静态内容与高亮度可能增加残影、显示老化及热风险。请保持通风。"
          }
        }
      }
    },
    "risk.enable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable Always On"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启始终常亮"
          }
        }
      }
    },
    "setup.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable Closed-Lid Support"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用合盖支持"
          }
        }
      }
    },
    "setup.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "栖明·Qiming needs a small helper to manage closed-lid sessions and restore its changes. Approve the helper in System Settings, then select Set Up again to connect."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "栖明·Qiming 需要一个小型辅助组件管理合盖会话，并在退出或失联后恢复修改。请在系统设置中批准组件，再次点击“配置”完成连接。"
          }
        }
      }
    },
    "setup.action": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",

    "app.version": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Version"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "版本"
          }
        }
      }
    },
    "brand.tagline": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Screen off. Work goes on."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "屏息，续行。"
          }
        }
      }
    },
    "mode.system": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Follow System"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "跟随系统"
          }
        }
      }
    },
    "mode.system.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use your Mac’s normal behavior."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保持 Mac 原有的显示与睡眠行为。"
          }
        }
      }
    },
    "mode.closed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Screen Off When Closed"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "合盖熄屏，持续运行"
          }
        }
      }
    },
    "mode.closed.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Screen on when open. Mac stays awake when closed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开盖保持内屏常亮；合盖熄屏，任务继续。"
          }
        }
      }
    },
    "mode.displayOnly": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Screen On When Open"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开盖常亮，合盖休眠"
          }
        }
      }
    },
    "mode.displayOnly.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep the display on while open. Allow normal system sleep when closed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开盖保持内屏常亮；合盖后由 macOS 正常休眠，任务暂停。"
          }
        }
      }
    },
    "state.displayOnly": {
      "extractionState": "manual",
      "localizations": {

    "status.privacy": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review before exporting. Edit to remove sensitive content. Assertion names from other apps may include task information."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导出前请检查内容，可直接编辑以删除敏感信息。断言名称由其他应用提供，可能包含任务信息。"
          }
        }
      }
    },
    "verification": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Verify Closed-Lid Behavior"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "合盖实机验证指引"
          }
        }
      }
    },
    "verification.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save your work and disconnect all external displays.\n\n1. Start a task that continuously writes timestamps.\n2. Connect power, select Screen Off When Closed, close the lid fully and verify the screen is physically off.\n3. Open the lid and check that the task kept progressing.\n4. Separately verify Always On with the lid fully closed, including screen illumination, screen saver and auto-lock.\n5. Stop the session and confirm normal sleep is restored. Repeat on battery, across power changes, and after forced quit.\n\nStatus can confirm whether macOS accepted display requests and whether assertions are held. Check the Mac itself to confirm the built-in display is physically on or off and whether the Mac actually slept."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先保存工作，并断开所有外接显示器。\n\n1. 启动一个会持续输出时间戳的任务。\n2. 接通电源，选择合盖熄屏，完全合盖后确认内屏确实熄灭。\n3. 开盖检查任务日志是否持续推进。\n4. 始终常亮需另行检查完全合盖后的内屏发光、屏保与自动锁屏。\n5. 结束会话，确认原睡眠行为恢复；再分别测试电池、电源切换及异常退出。\n\n状态页可确认系统是否接受常亮或熄屏请求，以及是否持有断言。内屏实际亮灭和 Mac 是否真的休眠，需要在这台机器上实测。"
          }
        }
      }
    },
